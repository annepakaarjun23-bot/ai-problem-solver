# Copy to .env and fill in the values. Never commit .env.

# Neon connection string. Use the asyncpg SQLAlchemy scheme and require TLS.
# URL-encode reserved characters in the username/password.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require

# Optional Neon direct connection used only by Alembic migrations (host must not use -pooler).
# If omitted, Alembic falls back to DATABASE_URL.
MIGRATION_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@DIRECT_HOST/DBNAME?sslmode=require&channel_binding=require

# AI provider (OpenAI-compatible)
AI_ROUTER_API_KEY=replace_with_provider_api_key
AI_ROUTER_BASE_URL=https://api.airouter.in/v1
AI_ROUTER_MODEL=openai/gpt-6-luna

# Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace_with_random_secret_at_least_32_characters
# Compose sets ENVIRONMENT=production for the backend. Keep false for the initial HTTP setup;
# change to true after HTTPS is configured.
COOKIE_SECURE=false
# Include the exact browser origins you use, separated by commas.
# For initial HTTP EC2 access, add http://EC2_PUBLIC_IP (and your local origin for local testing).
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
